# 먼저 데모 화면을 확인한 뒤 실제 연동 시 false로 바꾸세요.
KOCOM_DEMO=true

# 코콤 홈매니저 로그인 정보(브라우저가 아닌 서버에서만 사용)
KOCOM_USER_ID=
KOCOM_PASSWORD=
KOCOM_PHONE=

# 최소 15분, 권장 60분
KOCOM_POLL_MINUTES=60
KOCOM_DB_PATH=family_hub.db

# 계약종별: high(주택용 고압) 또는 low(주택용 저압)
ELECTRICITY_VOLTAGE=high

# 4인 가구 비교 기준. 필요하면 실제 기준값으로 조정하세요.
