[Unit]
Description=Family Hub Gunicorn Server
After=network.target

[Service]
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__APP_DIR__
Environment="PATH=__APP_DIR__/venv/bin"
EnvironmentFile=-__APP_DIR__/.env
ExecStart=__APP_DIR__/venv/bin/gunicorn --workers 3 --bind unix:__APP_DIR__/family-hub.sock --umask 007 --timeout 60 server:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
